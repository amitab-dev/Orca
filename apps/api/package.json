{
    "name": "api",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch run src/index.ts",
        "worker": "bun run src/worker/index.ts",
        "start": "bun run dist/index.ts",
        "build": "bun build ./index.ts --outdir ./dist",
        "typecheck": "tsc --noEmit",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bunx drizzle-kit migrate",
        "db:push": "bunx drizzle-kit push",
        "db:studio": "bunx drizzle-kit studio"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "pino-pretty": "^13.2.0"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.3",
        "@fastify/cors": "^11.3.1",
        "@fastify/jwt": "^10.2.4",
        "@fastify/oauth2": "^8.3.1",
        "dotenv": "^18.0.7",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.7",
        "fastify-plugin": "^6.0.1",
        "fastify-type-provider-zod": "^7.0.0",
        "pg": "^8.23.1",
        "slugify": "^1.6.9",
        "zod": "^4.6.7"
    }
}